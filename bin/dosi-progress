#!/bin/sh
# dosi-progress — the progressive-disclosure engine (RFC §3.2, §6.4).
#
# Per-project state lives in <plugin data>/progress/<hash>.state as
# key=value lines. Hooks `record` what happened and, during a turn that
# answers a question, ask `next --pending` for the one hint or question due.
# The agent passes it on in the user's language.
#
#   dosi-progress stage                 print S0..S6
#   dosi-progress next [--pending]      at most one one-time hint (--pending:
#                                       during a turn, counting its answer):
#                                         HINT: <text>
#                                         ASK: <question> | <opt1> | <opt2> | <opt3>
#                                       (prints nothing when there is none)
#   dosi-progress peek                  what `next` would print, without using it up
#   dosi-progress answer <ask> <yes|later|never>
#   dosi-progress record <event> [n]    connected | model | queried | answered |
#                                       select | ambiguous | lineage | ontology |
#                                       entity_question | datasets <n> | relationships <n>
#   dosi-progress turn                  the turn ended: one answer if it queried
#   dosi-progress dismiss <hint>        never show that hint again
#   dosi-progress status                the raw state, for /dosi and debugging
self_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
DOSI_LIB_ROOT=${DOSI_LIB_ROOT:-$(dirname -- "$self_dir")}
. "$DOSI_LIB_ROOT/hooks/lib.sh"

proj=$(dosi_project)
dir="$(dosi_data)/progress"
mkdir -p "$dir"
file="$dir/$(printf '%s' "$proj" | cksum | awk '{print $1}').state"
[ -f "$file" ] || printf 'project=%s\n' "$proj" > "$file"

get() { sed -n "s/^$1=//p" "$file" | tail -n 1; }
num() { v=$(get "$1"); printf '%s\n' "${v:-0}"; }
set_() {
  tmp="$file.$$"
  grep -v "^$1=" "$file" > "$tmp" 2>/dev/null
  printf '%s=%s\n' "$1" "$2" >> "$tmp"
  mv "$tmp" "$file"
}
incr() { set_ "$1" $(( $(num "$1") + ${2:-1} )); }
# Answers so far; during a turn (`next --pending`) the one being written
# counts too.
answers() { echo $(( $(num answered) + ${PENDING_ANSWER:-0} )); }

# S4 thresholds (RFC Q5: start here, calibrate with eval E4).
S4_MIN_DATASETS=3
S4_MIN_SELECTS=2

ontology_ready() {
  [ "$(num model)" -ge 1 ] || return 1
  # Not on the first answers: the suggestion only makes sense once the user
  # has asked a few questions across entities.
  [ "$(answers)" -ge 3 ] || return 1
  [ "$(num datasets)" -ge "$S4_MIN_DATASETS" ] || return 1
  [ "$(num relationships)" -ge 1 ] || return 1
  [ "$(num selects)" -ge "$S4_MIN_SELECTS" ] \
    || [ "$(num ambiguous)" -ge 1 ] \
    || [ "$(num entity_questions)" -ge 2 ]
}

stage() {
  if [ "$(num ontology)" -ge 1 ]; then echo S5
  elif ontology_ready; then echo S4
  elif [ "$(num lineage)" -ge 1 ]; then echo S3
  elif [ "$(num model)" -ge 1 ]; then echo S2
  elif [ "$(num connected)" -ge 1 ]; then echo S1
  else echo S0
  fi
}

# A hint may show when it has not been shown, was not dismissed, and (for a
# "later") the user has asked enough new questions since.
may_show() {
  [ "$(num "never_$1")" -ge 1 ] && return 1
  after=$(get "after_$1")
  if [ -n "$after" ]; then
    [ "$(answers)" -ge "$after" ] || return 1
    return 0
  fi
  [ "$(num "shown_$1")" -ge 1 ] && return 1
  return 0
}

shown() { [ -n "${PEEK:-}" ] && return 0; set_ "shown_$1" 1; grep -v "^after_$1=" "$file" > "$file.$$"; mv "$file.$$" "$file"; }

in_git_repo() { git -C "$proj" rev-parse --is-inside-work-tree >/dev/null 2>&1; }

# Facts the filesystem already knows, so a model or ontology written in the
# middle of a session counts without waiting for the next SessionStart.
sync_files() {
  [ -f "$proj/dosi/model.yaml" ] && [ "$(num model)" -lt 1 ] && set_ model 1
  [ -f "$proj/dosi/ontology.yaml" ] && [ "$(num ontology)" -lt 1 ] && set_ ontology 1
  return 0
}

# S6: the model file unchanged for a day and in use since (resumed and
# compacted sessions are not new days, so counting sessions over-counts).
model_settled() {
  since=$(num model_since)
  [ "$since" -gt 0 ] || return 1
  [ $(( $(date +%s) - since )) -ge 86400 ] && [ "$(answers)" -ge 3 ]
}

next() {
  sync_files
  if [ "$(num ontology)" -ge 1 ] && may_show h_ontology_ready; then
    shown h_ontology_ready
    echo "HINT: You can now ask by business concept, and ask to see how the concepts connect."
    return
  fi
  if [ "$(num ontology)" -lt 1 ] && ontology_ready && may_show h_ontology; then
    shown h_ontology
    echo "ASK: Your recent questions join several kinds of business objects. An ontology names those objects and how they relate, so you can ask in business terms and the joins come out right. It takes a few minutes and adds two files; data and metrics stay as they are. Build it now? | Build it now | Later | Never ask again"
    echo "(answer with: dosi-progress answer h_ontology yes|later|never)"
    return
  fi
  if [ "$(answers)" -ge 1 ] && [ "$(num lineage)" -lt 1 ] && may_show h_lineage; then
    shown h_lineage
    echo "HINT: Ask how any of these numbers is computed to see where it comes from."
    return
  fi
  if [ "$(num model)" -ge 1 ] && model_settled && in_git_repo && may_show h_team; then
    shown h_team
    echo "ASK: The model has been stable for a while. Commit the dosi/ folder to this git repository, so everyone who pulls it uses the same metric definitions? Connections and passwords are not committed. | Commit it | Later | Never ask again"
    echo "(answer with: dosi-progress answer h_team yes|later|never)"
    return
  fi
}

cmd=${1:-status}
[ $# -gt 0 ] && shift
case "$cmd" in
  stage) sync_files; stage ;;
  next)
    # `next --pending`: asked during a turn, from the first query's hook.
    # The answer being written counts, and one hint per turn at most.
    if [ "${1:-}" = --pending ]; then
      [ "$(num hinted_turn)" -ge 1 ] && exit 0
      [ "$(num queried)" -ge 1 ] && PENDING_ANSWER=1
      out=$(next)
      [ -n "$out" ] && [ -z "${PEEK:-}" ] && set_ hinted_turn 1
      [ -n "$out" ] && printf '%s\n' "$out"
    else
      next
    fi ;;
  turn)
    # A user question counts once however many queries answered it: the
    # hints wait for a few questions, not a few calls (one analysis ran 15).
    if [ "$(num queried)" -ge 1 ]; then incr answered; set_ queried 0; fi
    set_ hinted_turn 0 ;;
  peek) PEEK=1 next ;;
  answer)
    case "${2:-}" in
      never) set_ "never_$1" 1 ;;
      later) set_ "after_$1" $(( $(num answered) + 10 )) ;;
      *) : ;;
    esac ;;
  dismiss) set_ "never_$1" 1 ;;
  record)
    ev=${1:?event}
    case "$ev" in
      connected|model|lineage|ontology) set_ "$ev" 1 ;;
      queried) set_ queried 1 ;;
      answered) incr answered ;;
      select) incr selects ;;
      ambiguous) incr ambiguous ;;
      entity_question) incr entity_questions ;;
      datasets|relationships) set_ "$ev" "${2:-0}" ;;
      session)
        # Model stability for S6: remember when the model file last changed.
        m="$proj/dosi/model.yaml"
        if [ -f "$m" ]; then
          sig=$(cksum < "$m" | awk '{print $1}')
          if [ "$sig" != "$(get model_sig)" ]; then
            set_ model_sig "$sig"; set_ model_since "$(date +%s)"
          fi
        fi ;;
      *) echo "dosi-progress: unknown event $ev" >&2; exit 2 ;;
    esac ;;
  status) sync_files; echo "stage=$(stage)"; cat "$file" ;;
  *) echo "usage: dosi-progress stage|next|turn|answer|record|dismiss|status" >&2; exit 2 ;;
esac
