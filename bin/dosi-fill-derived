#!/usr/bin/env python3
"""dosi-fill-derived — write each derived metric's expansion into the model.

A derived metric (a DATUS `derive` of type filter or compose) must also
carry its flattened expansion as the OSI core `expression`. dosi computes
that expansion; this command takes it from `dosi validate` and writes it in
place, so the expansion is never typed by hand:

  1. write the derived metric with its `derive` declaration and, as its
     `expression`, any aggregate over a field it uses (`COUNT(orders.order_id)`);
  2. run `dosi-fill-derived` (after a batch of such metrics, not after each);
  3. it rewrites those `expression`s and validates again.

  dosi-fill-derived [--model dosi/model.yaml] [--dry-run]

Only `derive_expression_mismatch` errors that name the expansion are
touched; every other problem is left for the author and listed in the
output. The rewritten `expression` keeps the metric's first dialect and is
written on one line as `{dialects: [{dialect: D, expression: "..."}]}`.
Output: one JSON object — `filled` (how many metrics), `valid`,
`remaining_count` and the first eight `remaining` problems (code / location /
message / hint).
Exit status: 0 when it ran, 2 on a dosi or usage error.
"""
import argparse
import fcntl
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.abspath(__file__))


def dosi_cmd():
    shim = os.path.join(HERE, "dosi")
    return [shim] if os.access(shim, os.X_OK) else [shutil.which("dosi") or "dosi"]


def validate(model):
    env = dict(os.environ, DOSI_MODEL=os.path.abspath(model))
    proc = subprocess.run(dosi_cmd() + ["validate", "--format", "json"],
                          capture_output=True, text=True, env=env)
    try:
        return json.loads(proc.stdout)
    except ValueError:
        return {"error": (proc.stderr or proc.stdout).strip()[:2000]}


def problems(verdict):
    out = []
    for item in (verdict.get("issues") or []) + (verdict.get("compile_errors") or []):
        if isinstance(item, dict):
            out.append(item)
        else:
            out.append({"message": str(item)})
    return out


def expected(problem):
    """The expansion to write: the error's field, or (dosi before #371) the
    SQL its hint quotes."""
    if problem.get("expected_expression"):
        return problem["expected_expression"]
    m = re.search(r"for this declaration it is (.+)$", problem.get("hint") or "", re.S)
    return m.group(1).strip() if m else None


def indent_of(line):
    return len(line) - len(line.lstrip(" "))


def blank(line):
    s = line.strip()
    return not s or s.startswith("#")


def metric_regions(lines):
    """Line ranges [start, end) of every `metrics:` block."""
    regions = []
    for i, line in enumerate(lines):
        if re.match(r"^\s*metrics:\s*(#.*)?$", line):
            ind = indent_of(line)
            j = i + 1
            while j < len(lines) and (blank(lines[j]) or indent_of(lines[j]) > ind
                                      or (indent_of(lines[j]) == ind and lines[j].lstrip().startswith("- "))):
                j += 1
            regions.append((i + 1, j))
    return regions


def flow_extent(lines, start, col):
    """End (exclusive) of a flow value that starts at lines[start][col:]."""
    depth, quote = 0, None
    for j in range(start, len(lines)):
        text = lines[j][col:] if j == start else lines[j]
        k = 0
        while k < len(text):
            c = text[k]
            if quote:
                if c == "\\" and quote == '"':
                    k += 2
                    continue
                if c == quote:
                    if quote == "'" and text[k + 1:k + 2] == "'":
                        k += 2
                        continue
                    quote = None
            elif c in "\"'":
                quote = c
            elif c in "{[":
                depth += 1
            elif c in "}]":
                depth -= 1
                if depth == 0:
                    return j + 1
            elif c == "#" and (k == 0 or text[k - 1] == " ") and depth == 0:
                break
            k += 1
    return None


def fill(lines, name, sql):
    """Rewrite metric `name`'s core expression in place; True when done."""
    for start, end in metric_regions(lines):
        for i in range(start, end):
            m = re.match(r"^(\s*)-\s+name:\s*(['\"]?)(.+?)\2\s*(#.*)?$", lines[i])
            if not m or m.group(3) != name:
                continue
            dash = len(m.group(1))
            key_col = lines[i].index("name:")
            # The item's own block: until the next line at or left of the dash.
            j = i + 1
            while j < end and (blank(lines[j]) or indent_of(lines[j]) > dash):
                j += 1
            for k in range(i + 1, j):
                e = re.match(r"^(\s*)expression:\s*(.*)$", lines[k])
                if not e or len(e.group(1)) != key_col:
                    continue
                rest = e.group(2)
                if rest.startswith("{"):
                    stop = flow_extent(lines, k, lines[k].index("{"))
                    if stop is None:
                        return False
                else:
                    stop = k + 1
                    while stop < j and (blank(lines[stop]) or indent_of(lines[stop]) > key_col):
                        stop += 1
                old = "\n".join(lines[k:stop])
                d = re.search(r"dialect:\s*['\"]?([A-Za-z_]+)", old)
                dialect = d.group(1) if d else "ANSI_SQL"
                lines[k:stop] = [" " * key_col + "expression: {dialects: [{dialect: %s, expression: %s}]}"
                                 % (dialect, json.dumps(sql, ensure_ascii=False))]
                return True
            return False
    return False


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--model", default="dosi/model.yaml")
    ap.add_argument("--dry-run", action="store_true", help="say what would change, write nothing")
    a = ap.parse_args()
    if not os.path.isfile(a.model):
        print(json.dumps({"error": f"no model at {a.model}"}))
        return 2

    if a.dry_run:
        with tempfile.TemporaryDirectory(prefix="dosi-preview-") as directory:
            target = os.path.join(directory, os.path.basename(a.model))
            shutil.copy2(a.model, target)
            os.chmod(target, stat.S_IMODE(os.stat(target).st_mode) | stat.S_IWUSR)
            a.model = target
            return fill_model(a)
    a.model = os.path.realpath(a.model)
    return fill_model(a)


def fill_model(a):
    # A derived metric's expansion is built from its members as they stand:
    # while a member still holds its placeholder, the dependent's expansion
    # is wrong too. Refill whatever comes back with a new expansion until
    # nothing changes.
    filled, missed, written = [], [], {}
    for _ in range(12):
        for _attempt in range(3):
            with open(a.model, "rb") as source:
                before = source.read()
            verdict = validate(a.model)
            with open(a.model, "rb") as source:
                snapshot = source.read()
            if snapshot == before:
                break
        else:
            print(json.dumps({"error": "model changed during validation; read it again and retry"}))
            return 2
        if "error" in verdict:
            print(json.dumps({"error": "dosi validate failed", "detail": verdict["error"]}, ensure_ascii=False))
            return 2
        todo = [(re.sub(r"^metric '(.*)'$", r"\1", p.get("location", "")), expected(p))
                for p in problems(verdict) if p.get("code") == "derive_expression_mismatch"]
        todo = [(n, s) for n, s in todo if s]
        todo = [(n, s) for n, s in todo if n not in missed and written.get(n) != s]
        if not todo:
            break
        lines = snapshot.decode("utf-8").split("\n")
        for name, sql in todo:
            if fill(lines, name, sql):
                written[name] = sql
                if name not in filled:
                    filled.append(name)
            else:
                missed.append(name)
        if a.dry_run:
            break
        directory = os.path.dirname(a.model) or "."
        lock_path = os.path.join(directory, "." + os.path.basename(a.model) + ".dosi.lock")
        with open(lock_path, "a+b") as lock:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
            with open(a.model, "rb") as source:
                if source.read() != snapshot:
                    print(json.dumps({"error": "model changed during editing; read it again and retry"}))
                    return 2
            mode = stat.S_IMODE(os.stat(a.model).st_mode)
            with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=directory, delete=False) as f:
                tmp = f.name
                f.write("\n".join(lines))
                f.flush()
                os.fsync(f.fileno())
            try:
                os.chmod(tmp, mode)
                os.replace(tmp, a.model)
            finally:
                if os.path.exists(tmp):
                    os.unlink(tmp)

    verdict = validate(a.model) if not a.dry_run else verdict
    remaining = [{k: p.get(k) for k in ("code", "location", "message", "hint") if p.get(k)}
                 for p in problems(verdict)]
    # Sized for an agent's context: the first problems in full, then a count.
    out = {"filled": len(filled), "valid": not remaining, "remaining_count": len(remaining),
           "remaining": remaining[:8]}
    if missed:
        out["not_found"] = missed
    if a.dry_run:
        out["dry_run"] = True
    print(json.dumps(out, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
