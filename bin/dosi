#!/bin/sh
# dosi shim — on PATH while the plugin is enabled (Claude Code adds bin/).
# Runs the dosi binary this plugin version pins (RFC Q3), in order:
#   1. $DOSI_BIN, exported by the SessionStart hook
#   2. the pinned install under the plugin data dir
#   3. another `dosi` on PATH whose version matches
# and otherwise answers with the CLI's JSON error shape, so the agent reads
# `dosi_installing` / `install_failed` like any other dosi error.
self_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
DOSI_LIB_ROOT=$(dirname -- "$self_dir")
. "$DOSI_LIB_ROOT/hooks/lib.sh"

want=$(dosi_plugin_version)

# The project's model and ontology without --model: a model written earlier
# in this session is not in the env file SessionStart wrote.
proj=${CLAUDE_PROJECT_DIR:-$PWD}
if [ -z "${DOSI_MODEL:-}" ] && [ -f "$proj/dosi/model.yaml" ]; then
  DOSI_MODEL="$proj/dosi/model.yaml"; export DOSI_MODEL
fi
if [ -z "${DOSI_ONTOLOGY:-}" ] && [ -f "$proj/dosi/ontology.yaml" ]; then
  DOSI_ONTOLOGY="$proj/dosi/ontology.yaml"; export DOSI_ONTOLOGY
fi

if [ -n "${DOSI_BIN:-}" ] && [ -x "$DOSI_BIN" ]; then
  exec "$DOSI_BIN" "$@"
fi

pinned="$(dosi_bin_dir)/dosi"
if [ -x "$pinned" ] && [ -f "$(dosi_bin_dir)/.ok" ]; then
  exec "$pinned" "$@"
fi

# Another dosi on PATH, skipping this shim's own directory.
old_ifs=$IFS
IFS=:
for dir in $PATH; do
  [ "$dir" = "$self_dir" ] && continue
  [ -x "$dir/dosi" ] || continue
  IFS=$old_ifs
  have=$("$dir/dosi" --version 2>/dev/null | awk '{print $2}')
  if [ "$have" = "$want" ]; then
    exec "$dir/dosi" "$@"
  fi
  IFS=:
done
IFS=$old_ifs

state_dir=$(dosi_bin_dir)
if [ -f "$state_dir/.failed" ]; then
  reason=$(tail -n 3 "$state_dir/.failed" 2>/dev/null)
  printf '{"code":"install_failed","message":"dosi %s could not be installed","reason":"%s","hint":"Check the network, or retry with the China mirror: DOSI_SOURCE=oss sh %s/hooks/install.sh (DOSI_VERSION=%s DOSI_INSTALL_DIR=%s)"}\n' \
    "$want" "$(json_str "$reason")" "$DOSI_LIB_ROOT" "$want" "$state_dir"
  exit 3
fi
printf '{"code":"dosi_installing","message":"dosi %s is being installed in the background (first run, about 20s)","hint":"Wait a few seconds and run the same command again; nothing to tell the user."}\n' "$want"
# Start the install if nobody has (e.g. the session began before the plugin).
if [ ! -f "$state_dir/.lock" ]; then
  sh "$DOSI_LIB_ROOT/hooks/ensure-binary.sh" >/dev/null 2>&1 &
fi
exit 3
