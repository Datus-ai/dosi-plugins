#!/bin/sh
# dosi shim — on PATH while the plugin is enabled (Claude Code adds bin/).
# Runs, in order:
#   1. the release the plugin installed (bin/current under the plugin data
#      dir), when it is no older than DOSI_MIN_VERSION — or DOSI_DEV_BIN_DIR
#   2. another `dosi` on PATH no older than DOSI_MIN_VERSION, while the
#      plugin's own install is missing or pending
# and otherwise answers with the CLI's JSON error shape, so the agent reads
# `dosi_installing` / `install_failed` like any other dosi error.
self_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
DOSI_LIB_ROOT=$(dirname -- "$self_dir")
. "$DOSI_LIB_ROOT/hooks/lib.sh"

want=$(dosi_min_version)

# The project's model and ontology without --model: a model written earlier
# in this session is not in the env file SessionStart wrote.
proj=${CLAUDE_PROJECT_DIR:-$PWD}
if [ -z "${DOSI_MODEL:-}" ] && [ -f "$proj/dosi/model.yaml" ]; then
  DOSI_MODEL="$proj/dosi/model.yaml"; export DOSI_MODEL
fi
if [ -z "${DOSI_ONTOLOGY:-}" ] && [ -f "$proj/dosi/ontology.yaml" ]; then
  DOSI_ONTOLOGY="$proj/dosi/ontology.yaml"; export DOSI_ONTOLOGY
fi
if [ -z "${DOSI_MAPPING:-}" ] && [ -f "$proj/dosi/mapping.yaml" ]; then
  DOSI_MAPPING="$proj/dosi/mapping.yaml"; export DOSI_MAPPING
fi

# Connection secrets the user keeps outside the project (optional): the
# same file the MCP server reads with --env-file.
dosi_load_secrets

if dosi_bin_ready; then
  exec "$(dosi_bin_dir)/dosi" "$@"
fi

# Another dosi on PATH, skipping this shim's own directory.
old_ifs=$IFS
IFS=:
for dir in $PATH; do
  [ "$dir" = "$self_dir" ] && continue
  [ -x "$dir/dosi" ] || continue
  IFS=$old_ifs
  have=$("$dir/dosi" --version 2>/dev/null | awk '{print $2}')
  if dosi_version_ge "$have" "$want"; then
    exec "$dir/dosi" "$@"
  fi
  IFS=:
done
IFS=$old_ifs

state_dir="$(dosi_data)/bin"
if [ -f "$state_dir/.failed" ] && [ ! -f "$state_dir/.lock" ]; then
  reason=$(tail -n 3 "$state_dir/.failed" 2>/dev/null)
  printf '{"code":"install_failed","message":"dosi could not be installed (this plugin needs %s or newer)","reason":"%s","hint":"Check the network, then run dosi-upgrade; in mainland China set DOSI_SOURCE=oss"}\n' \
    "$want" "$(json_str "$reason")"
  # Try again in the background, so the next call can succeed.
  dosi_install_in_background
  exit 3
fi
printf '{"code":"dosi_installing","message":"the newest dosi is being installed in the background (about 20s)","hint":"Wait a few seconds and run the same command again; nothing to tell the user."}\n'
# Start the install if nobody has (e.g. the session began before the plugin).
[ -f "$state_dir/.lock" ] || dosi_install_in_background
exit 3
